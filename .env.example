# Al Shehail Food Industries — environment variable template
#
# Copy to `.env.local` for local development and fill in real values.
# `.env.local` is git-ignored. NEVER commit real secrets — configure the
# server-only secrets (SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY,
# TURNSTILE_SECRET_KEY) directly in the Vercel project settings.
#
# Only NEXT_PUBLIC_* variables are exposed to the browser bundle. Every other
# variable here is server-only and must never be referenced from a Client
# Component or a NEXT_PUBLIC_* name.

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alshehai.ae

# ── Supabase (foundation only in Patch 01 — not yet wired to content) ─────
# Public (safe for the browser): project URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: full-access service role key. NEVER expose to the client.
# OPERATOR-ONLY: used solely by the operator CLI scripts (db:seed:*, db:verify,
# db:auth:invite:apply, db:members:bootstrap:apply, db:members:verify). It is
# NOT a website/dashboard runtime dependency and must NEVER be configured as a
# Vercel runtime env var, referenced from any Next.js server/client code, or
# reach the client bundle. The dashboard authenticates with the anon key + the
# signed-in user's session only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Dashboard auth flow (Patch 04) ────────────────────────────────────────
# Server-only HMAC secret that signs the short-lived password recovery/invite
# authorization gate. NEVER a NEXT_PUBLIC_ variable; never exposed to the client.
# Generate a high-entropy value, e.g.: `openssl rand -base64 48`.
DASHBOARD_AUTH_FLOW_SECRET=

# ── Email delivery (Resend — not implemented in Patch 01) ─────────────────
# Server-only API key.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Al Shehail Website <info@alshehai.ae>
CONTACT_TO_EMAILS=marketing@halsabake.com,osama@halsabake.com

# ── Cloudflare Turnstile (bot protection — not implemented in Patch 01) ───
# Public site key is safe for the browser; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Admin dashboard access (not implemented in Patch 01) ──────────────────
# Server-only allowlist of emails permitted to access the future dashboard.
ADMIN_ALLOWED_EMAILS=marketing@halsabake.com,osama@halsabake.com,gm@elshohail.com
