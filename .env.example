# Al Shehail Food Industries — environment variable template
#
# Copy to `.env.local` for local development and fill in real values.
# `.env.local` is git-ignored. NEVER commit real secrets.
#
# Only NEXT_PUBLIC_* variables are exposed to the browser bundle. Every other
# variable here is server-only and must never be referenced from a Client
# Component or a NEXT_PUBLIC_* name.
#
# Two clearly separated groups below:
#   (A) WEBSITE PRODUCTION RUNTIME — configured in the Vercel project (the
#       deployed site/dashboard reads these at runtime).
#   (B) OPERATOR-ONLY (LOCAL) — used ONLY by the operator CLI scripts from a
#       trusted shell. These must NEVER be configured as Vercel runtime env
#       vars and never reach any Next.js server/client code or the bundle.

# ============================================================================
# (A) WEBSITE PRODUCTION RUNTIME  (set these in Vercel → Production)
# ============================================================================

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alshehai.ae

# ── Supabase (public, safe for the browser) ───────────────────────────────
# Project URL + anon key. The dashboard authenticates with the anon key plus
# the signed-in user's session — never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Dashboard auth flow ───────────────────────────────────────────────────
# Server-only HMAC secret that signs the short-lived password recovery/invite
# authorization gate. NEVER a NEXT_PUBLIC_ variable; never exposed to the client.
# Generate a high-entropy value, e.g.: `openssl rand -base64 48`.
DASHBOARD_AUTH_FLOW_SECRET=

# ── Contact/admin allowlist (server-only) ─────────────────────────────────
# Server-only allowlist of contact recipients / admin emails.
ADMIN_ALLOWED_EMAILS=marketing@halsabake.com,osama@halsabake.com,gm@elshohail.com

# ── Email delivery (Resend — feature reserved, not yet wired) ─────────────
# Server-only API key. Configure only once the contact/email feature ships.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Al Shehail Website <info@alshehai.ae>
CONTACT_TO_EMAILS=marketing@halsabake.com,osama@halsabake.com

# ── Cloudflare Turnstile (bot protection — feature reserved, not yet wired) ─
# Public site key is safe for the browser; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================================
# (B) OPERATOR-ONLY (LOCAL, trusted shell) — NEVER Vercel runtime variables
# ============================================================================
# These power the operator CLI scripts only (db:seed:*, db:verify,
# db:auth:invite:apply, db:members:bootstrap:apply, db:members:verify). They are
# NOT website/dashboard runtime dependencies and must NEVER be added to Vercel,
# referenced from any Next.js code, or reach the client bundle.

# Full-access service role key (bypasses RLS). Operator-only.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI access token (for `supabase link` / migrations). Operator-only.
SUPABASE_ACCESS_TOKEN=

# Database password (direct psql / migration apply). Operator-only.
SUPABASE_DB_PASSWORD=

# Expected production project ref — validated by the invitation tool before any
# write. NON-SECRET, but resolve it during read-only preflight (do not invent).
# Operator-only.
SUPABASE_PROJECT_REF=
